rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null && request.auth.token.email_verified == true; }
    function email() { return request.auth.token.email.lower(); }
    function isAdmin() { return signedIn() && email() in ['jamesmfitchett@gmail.com']; }
    function onTeam() {
      return isAdmin() || (signedIn()
        && exists(/databases/$(database)/documents/config/access)
        && email() in get(/databases/$(database)/documents/config/access).data.emails);
    }
    // Any shared board, now or added later. These collections have their own rules below.
    function board(c) { return !(c in ['config','users','people','log','backups','decisions','moderation']); }

    // Team list: only James can change it.
    match /config/access { allow read: if onTeam(); allow write: if isAdmin(); }
    // Each person's name card: only they can write theirs.
    match /users/{uid} { allow read: if onTeam(); allow write: if onTeam() && request.auth.uid == uid; }

    // Each person's comments and votes. Only they can write theirs, and the list can only grow:
    // nothing can be removed, and the record itself can never be deleted, by anyone.
    match /people/{uid} {
      allow read: if onTeam();
      allow create: if onTeam() && request.auth.uid == uid;
      allow update: if onTeam() && request.auth.uid == uid
        && request.resource.data.pins is list
        && (!('pins' in resource.data) || request.resource.data.pins.size() >= resource.data.pins.size());
      allow delete: if false;
    }

    // Permanent history: anyone on the team can add their own entries. Nobody can change or erase one.
    match /log/{id} {
      allow read: if onTeam();
      allow create: if onTeam() && (request.resource.data.by == request.auth.uid || isAdmin());
      allow update, delete: if false;
    }
    // Daily full backups: James only. Write-once.
    match /backups/{id} {
      allow read, create: if isAdmin();
      allow update, delete: if false;
    }

    // Vote-tab decisions and comment hiding: James only. Their history is write-once.
    match /decisions/{id} { allow read: if onTeam(); allow create, update: if isAdmin(); allow delete: if false; }
    match /decisions/{id}/history/{h} { allow read: if onTeam(); allow create: if isAdmin(); allow update, delete: if false; }
    match /moderation/{id} { allow read: if onTeam(); allow create, update: if isAdmin(); allow delete: if false; }

    // Shared boards: anyone on the team can add. James can edit anything; teammates only what they added.
    // Deleting is a soft delete (an edit). Only James can hard-delete.
    match /{col}/{id} {
      allow read: if board(col) && onTeam();
      allow create: if board(col) && onTeam() && (isAdmin() || request.resource.data.by == request.auth.uid);
      allow update: if board(col) && (isAdmin() || (onTeam()
        && resource.data.by == request.auth.uid && request.resource.data.by == resource.data.by));
      allow delete: if board(col) && isAdmin();
    }
    // Version history: anyone on the team can add a version; nobody can change or erase one.
    match /{col}/{id}/history/{h} {
      allow read, create: if board(col) && onTeam();
      allow update, delete: if false;
    }
  }
}
